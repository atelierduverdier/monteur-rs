// L'icône et la fiche du Monteur VerdierCAM sous Windows (Explorateur, barre des tâches, Gestionnaire des tâches).
// outils/construire-windows.sh la compile (windres) et la lie à l'exécutable.
1 ICON "monteur.ico"

1 VERSIONINFO
FILEVERSION     @V1@,@V2@,@V3@,0
PRODUCTVERSION  @V1@,@V2@,@V3@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "Atelier du Verdier"
      VALUE "FileDescription",  "Monteur VerdierCAM"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "monteur2"
      VALUE "LegalCopyright",   "GPL-3.0-or-later"
      VALUE "OriginalFilename", "Monteur VerdierCAM.exe"
      VALUE "ProductName",      "Monteur VerdierCAM"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
