  "sous_titres": [
   {
    "debut": 2.08,
    "fin": 6.04,
    "texte": "Bon, je vais montrer un peu comment on fait une pièce très"
   },
   {
    "debut": 6.04,
    "fin": 7.47,
    "texte": "très simple avec Verdier Cam"
   },
   {
    "debut": 7.47,
    "fin": 10.13,
    "texte": "pour commencer, afin de montrer un peu l'utilisation du logiciel."
   },
   {
    "debut": 12.1,
    "fin": 16.67,
    "texte": "Donc déjà, on a l'interface croquis et la vue 3D."
   },
   {
    "debut": 18.09,
    "fin": 21.45,
    "texte": "Donc quand on ouvre un logiciel, on tombe sur le brut"
   },
   {
    "debut": 21.45,
    "fin": 26.98,
    "texte": "et les contraintes, variables, mode d'emploi et brut."
   },
   {
    "debut": 27.3,
    "fin": 31.18,
    "texte": "Donc première chose à faire quand on a une pièce, c'est mesurer son brut."
   },
   {
    "debut": 32.32,
    "fin": 34.58,
    "texte": "Donc on va dire que j'ai un brut de 80 par 80."
   },
   {
    "debut": 36.97,
    "fin": 40.27,
    "texte": "Donc pour se faire, pour changer la dimension, on a deux façons de faire."
   },
   {
    "debut": 41.54,
    "fin": 46.61,
    "texte": "Soit on est en débutant, dimension et matière, on fait schéma."
   },
   {
    "debut": 48.38,
    "fin": 50.3,
    "texte": "Et là, on choisit les dimensions de son brut."
   },
   {
    "debut": 50.58,
    "fin": 53.84,
    "texte": "80, 80, appliqué."
   },
   {
    "debut": 54.47,
    "fin": 56.53,
    "texte": "Et le bois et la transparence du brut."
   },
   {
    "debut": 58.49,
    "fin": 60.95,
    "texte": "Donc soit on est en, entre guillemets, pro."
   },
   {
    "debut": 61.99,
    "fin": 69.15,
    "texte": "Et on peut aussi changer, à partir de là, dimension 80, 80, épaisseur."
   },
   {
    "debut": 70.38,
    "fin": 73.06,
    "texte": "Donc la différence entre le débutant et le pro, c'est juste ça."
   },
   {
    "debut": 73.52,
    "fin": 75.34,
    "texte": "Dans le débutant, il y a juste les schémas."
   },
   {
    "debut": 76.1,
    "fin": 78.52,
    "texte": "Et dans le pro, il y a tous les paramètres affichés."
   },
   {
    "debut": 81.77,
    "fin": 83.99,
    "texte": "Donc l'opacité, c'est l'opacité de la pièce."
   },
   {
    "debut": 85.73,
    "fin": 87.57,
    "texte": "Donc si je mets, par exemple, il faut aller dans 3D."
   },
   {
    "debut": 90.15,
    "fin": 95.41,
    "texte": "Donc là, on voit toute la table de la machine qui peut se"
   },
   {
    "debut": 95.41,
    "fin": 97.67,
    "texte": "montrer ou ne pas se montrer."
   },
   {
    "debut": 98.54,
    "fin": 101.82,
    "texte": "Donc l'opacité, je peux la mettre à 100% si je souhaite."
   },
   {
    "debut": 104.66,
    "fin": 108.27,
    "texte": "Voilà. Et là, je peux choisir dans la matière ce que je veux."
   },
   {
    "debut": 108.67,
    "fin": 110.33,
    "texte": "Par exemple, je vais prendre du contreplaqué."
   },
   {
    "debut": 112.8,
    "fin": 113.86,
    "texte": "Et ça fait ça."
   },
   {
    "debut": 117.16,
    "fin": 120.08,
    "texte": "En hauteur, je vais prendre 10 mm."
   },
   {
    "debut": 121.45,
    "fin": 122.53,
    "texte": "Ça me suffira largement."
   },
   {
    "debut": 125.17,
    "fin": 125.39,
    "texte": "Voilà."
   },
   {
    "debut": 126.98,
    "fin": 129.02,
    "texte": "Donc une fois que j'ai terminé dimension, je peux cliquer"
   },
   {
    "debut": 129.02,
    "fin": 130.84,
    "texte": "sur dimension, sur origine, pardon."
   },
   {
    "debut": 132.01,
    "fin": 134.01,
    "texte": "Et là, ça m'affiche simplement origine."
   },
   {
    "debut": 134.82,
    "fin": 137.48,
    "texte": "Hauteur, de face et tout, ça m'affiche tout."
   },
   {
    "debut": 138.37,
    "fin": 139.57,
    "texte": "Donc ça, c'est comme on souhaite."
   },
   {
    "debut": 140.42,
    "fin": 142.62,
    "texte": "Donc on va faire l'un après l'autre."
   },
   {
    "debut": 143.2,
    "fin": 143.52,
    "texte": "Origine."
   },
   {
    "debut": 144.34,
    "fin": 150.87,
    "texte": "Donc là, mon origine, elle est en bas à gauche de ma pièce pour moi."
   },
   {
    "debut": 151.7,
    "fin": 153.03,
    "texte": "Si je veux le changer, je peux le mettre là."
   },
   {
    "debut": 154.07,
    "fin": 155.77,
    "texte": "Là, ça, selon ce qu'on veut."
   },
   {
    "debut": 157.41,
    "fin": 160.48,
    "texte": "Et au-dessus. Parce qu'après, le martyre, ça fait en dessous."
   },
   {
    "debut": 163.37,
    "fin": 165.31,
    "texte": "Après, le repère, moi, je suis en G54."
   },
   {
    "debut": 165.53,
    "fin": 167.43,
    "texte": "Le G55, chez moi, il est là."
   },
   {
    "debut": 168.75,
    "fin": 170.79,
    "texte": "Donc après, c'est selon les réglages de la machine aussi."
   },
   {
    "debut": 174.19,
    "fin": 177.25,
    "texte": "Ça, c'est les hauteurs de sécurité des déplacements."
   },
   {
    "debut": 177.72,
    "fin": 179.0,
    "texte": "Et le retrait, le changement d'outil."
   },
   {
    "debut": 180.03,
    "fin": 183.39,
    "texte": "Si on travaille sur deux faces ou pas, alors je peux montrer le schéma."
   },
   {
    "debut": 185.15,
    "fin": 189.11,
    "texte": "Dessus, dessous. Et quand on travaille en deux faces, en Y."
   },
   {
    "debut": 190.69,
    "fin": 193.81,
    "texte": "Voilà. Là, ça met les goupilles. Et là, ça met des butées."
   },
   {
    "debut": 195.93,
    "fin": 197.63,
    "texte": "Pour l'instant, je ne le fais pas."
   },
   {
    "debut": 200.9,
    "fin": 204.45,
    "texte": "Quatrième axe, si on a un quatrième axe cylindrique."
   },
   {
    "debut": 204.71,
    "fin": 205.95,
    "texte": "Moi, je n'en ai pas sur ma machine."
   },
   {
    "debut": 208.98,
    "fin": 218.11,
    "texte": "Caisse identique. Alors par exemple, on peut mettre, on règle tous ces repères."
   },
   {
    "debut": 218.45,
    "fin": 220.63,
    "texte": "G54, 55, 56 où on souhaite."
   },
   {
    "debut": 221.57,
    "fin": 222.93,
    "texte": "Et on pose les pièces."
   },
   {
    "debut": 223.68,
    "fin": 226.5,
    "texte": "Et du coup, ça fait les mêmes pièces sur pièces identiques."
   },
   {
    "debut": 226.98,
    "fin": 228.98,
    "texte": "54, 55, 56. Voilà."
   },
   {
    "debut": 229.94,
    "fin": 234.34,
    "texte": "C'est un espèce de duplicata de pièces."
   },
   {
    "debut": 235.16,
    "fin": 237.3,
    "texte": "Donc ça, moi, je n'en veux pas. Donc j'efface."
   },
   {
    "debut": 238.19,
    "fin": 239.21,
    "texte": "Le post-processeur."
   },
   {
    "debut": 240.32,
    "fin": 242.13,
    "texte": "Alors pour ça, on choisit sa machine."
   },
   {
    "debut": 243.74,
    "fin": 245.0,
    "texte": "Et il faut régler aussi dans la machine."
   },
   {
    "debut": 245.08,
    "fin": 247.2,
    "texte": "J'ai rajouté une option sur la rigidité de la machine."
   },
   {
    "debut": 249.0,
    "fin": 250.02,
    "texte": "Donc on va dans table."
   },
   {
    "debut": 251.82,
    "fin": 252.63,
    "texte": "C'est brosse, pardon."
   },
   {
    "debut": 254.12,
    "fin": 258.18,
    "texte": "Donc la rigidité, donc celle que j'ai à l'atelier en GRBL,"
   },
   {
    "debut": 258.18,
    "fin": 260.31,
    "texte": "c'est un bâti en..."
   },
   {
    "debut": 260.31,
    "fin": 261.84,
    "texte": "C'est pas une costaude, c'est une légère."
   },
   {
    "debut": 262.42,
    "fin": 265.02,
    "texte": "C'est des profilés et courroies, petites broches."
   },
   {
    "debut": 265.36,
    "fin": 267.0,
    "texte": "Donc on peut faire des petites passes."
   },
   {
    "debut": 270.42,
    "fin": 272.7,
    "texte": "Et voilà. Après, il y a moyenne."
   },
   {
    "debut": 273.04,
    "fin": 275.08,
    "texte": "Donc là, c'est vis-habille, portique en profilé."
   },
   {
    "debut": 276.44,
    "fin": 280.61,
    "texte": "Et costaude. Alors moi, c'est bâti en acier ou en fonte."
   },
   {
    "debut": 281.43,
    "fin": 283.79,
    "texte": "Et là, on peut y aller à fond les ballons."
   },
   {
    "debut": 284.7,
    "fin": 288.67,
    "texte": "Donc je vais mettre légère, pince, l'écrou. Voilà."
   },
   {
    "debut": 289.65,
    "fin": 292.25,
    "texte": "La table, si on ne la veut pas..."
   },
   {
    "debut": 292.25,
    "fin": 298.56,
    "texte": "Alors moi, sur celle que j'ai à l'atelier, je n'ai pas de magasin."
   },
   {
    "debut": 298.72,
    "fin": 299.32,
    "texte": "Donc je peux l'enlever."
   },
   {
    "debut": 300.24,
    "fin": 301.96,
    "texte": "Donc là, ça a enlevé là."
   },
   {
    "debut": 302.1,
    "fin": 305.77,
    "texte": "Et si on ne veut pas la table, martyre."
   },
   {
    "debut": 306.81,
    "fin": 309.77,
    "texte": "Voilà. On peut l'enlever et du coup, ça l'enlève."
   },
   {
    "debut": 310.98,
    "fin": 313.12,
    "texte": "Donc on fait comme on veut."
   },
   {
    "debut": 314.15,
    "fin": 315.91,
    "texte": "Donc moi, je vais le remettre parce que j'aime bien."
   },
   {
    "debut": 316.43,
    "fin": 317.33,
    "texte": "Régler la machine."
   },
   {
    "debut": 319.41,
    "fin": 319.73,
    "texte": "Tire."
   },
   {
    "debut": 320.37,
    "fin": 323.69,
    "texte": "Voilà. Donc en plus, ce n'est pas vraiment la vraie dimension de mon martyre."
   },
   {
    "debut": 323.79,
    "fin": 325.12,
    "texte": "Mais bon, ce n'est pas grave. C'est la démo."
   },
   {
    "debut": 327.08,
    "fin": 329.36,
    "texte": "Donc une fois qu'on a fait ça, on va passer au dessin."
   },
   {
    "debut": 331.06,
    "fin": 334.0,
    "texte": "Donc pour le dessin, on a différents outils ici."
   },
   {
    "debut": 335.54,
    "fin": 337.8,
    "texte": "Donc il faut regarder à quoi ils servent."
   },
   {
    "debut": 337.8,
    "fin": 341.64,
    "texte": "Je ne vais pas faire pour l'instant toute la démonstration."
   },
   {
    "debut": 341.78,
    "fin": 344.77,
    "texte": "Il faut regarder le mode d'emploi. Mais c'est assez logique."
   },
   {
    "debut": 345.43,
    "fin": 347.23,
    "texte": "Et là, nous avons les contraintes."
   },
   {
    "debut": 347.51,
    "fin": 351.84,
    "texte": "Afin de coter la pièce, de le mettre en parallèle, de le"
   },
   {
    "debut": 351.84,
    "fin": 352.98,
    "texte": "mettre en symétrie et tout ça."
   },
   {
    "debut": 353.37,
    "fin": 357.13,
    "texte": "Alors par exemple, moi, pour ma pièce actuelle, je vais faire deux carrés."
   },
   {
    "debut": 360.71,
    "fin": 363.68,
    "texte": "Donc ça, ce sera le rebord de ma pièce."
   },
   {
    "debut": 364.44,
    "fin": 365.48,
    "texte": "Donc ce sera le contour ici."
   },
   {
    "debut": 366.3,
    "fin": 367.22,
    "texte": "Et là, il y aura la poche."
   },
   {
