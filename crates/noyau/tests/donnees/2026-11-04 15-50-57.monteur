   },
   {
    "debut": 1001.41,
    "fin": 1001.61,
    "texte": "Voilà."
   },
   {
    "debut": 1002.99,
    "fin": 1005.03,
    "texte": "Et après, sur quel coin, on le met ?"
   },
   {
    "debut": 1005.03,
    "fin": 1006.37,
    "texte": "Coin brut ici, coin brut là."
   },
   {
    "debut": 1012.25,
    "fin": 1016.38,
    "texte": "Voilà."
   },
   {
    "debut": 1017.14,
    "fin": 1019.38,
    "texte": "Bon, je crois que j'ai fait quand même un bon grand tour de"
   },
   {
    "debut": 1019.38,
    "fin": 1021.32,
    "texte": "cette première utilisation."
   },
   {
    "debut": 1021.53,
    "fin": 1025.33,
    "texte": "Donc je ne vais pas lancer l'usinage, parce qu'il me faut"
   },
   {
    "debut": 1025.33,
    "fin": 1028.37,
    "texte": "combien de temps d'ailleurs pour refaire ça ?"
   },
   {
    "debut": 1028.37,
    "fin": 1030.31,
    "texte": "Normalement, on voit la vitesse ici."
   },
   {
    "debut": 1030.45,
    "fin": 1033.37,
    "texte": "Là, il faut 1 minute 19 et 39 secondes."
   },
   {
    "debut": 1034.66,
    "fin": 1036.36,
    "texte": "Ah oui, il y a encore une autre chose aussi à faire, si on"
   },
   {
    "debut": 1036.36,
    "fin": 1037.99,
    "texte": "va avoir des vitesses exactes,"
   },
   {
    "debut": 1037.99,
    "fin": 1042.09,
    "texte": "lors du premier usinage, que je n'ai pas encore testé d'ailleurs,"
   },
   {
    "debut": 1042.09,
    "fin": 1043.61,
    "texte": "parce que je n'ai pas encore usiné trop."
   },
   {
    "debut": 1044.71,
    "fin": 1057.21,
    "texte": "C'est de réglage machine, général, tiens, montée en régime de la broche."
   },
   {
    "debut": 1057.33,
    "fin": 1059.61,
    "texte": "Déjà, moi, il me faut 5 secondes avant de démarrer, parce"
   },
   {
    "debut": 1059.61,
    "fin": 1061.39,
    "texte": "que sinon, elle n'est pas à fond dans les ballons."
   },
   {
    "debut": 1063.52,
    "fin": 1065.36,
    "texte": "Le courir, non, ce n'est pas ce que je souhaite."
   },
   {
    "debut": 1065.9,
    "fin": 1068.93,
    "texte": "Normalement, il y a une option pour le temps, pour faire"
   },
   {
    "debut": 1068.93,
    "fin": 1071.54,
    "texte": "une mise à niveau du temps, en fait."
   },
   {
    "debut": 1072.87,
    "fin": 1077.05,
    "texte": "Qui se trouve, facteur de chronométrage."
   },
   {
    "debut": 1077.19,
    "fin": 1084.45,
    "texte": "C'est-à-dire que si c'est écrit 2 minutes d'usinage, en"
   },
   {
    "debut": 1084.45,
    "fin": 1088.54,
    "texte": "gros, là, ça fait à peu près 2 minutes, j'arrondis."
   },
   {
    "debut": 1088.98,
    "fin": 1093.09,
    "texte": "Et si l'usinage se fait en 3 minutes, eh bien, on fait un"
   },
   {
    "debut": 1093.09,
    "fin": 1095.99,
    "texte": "produit en croix et puis on rectifie ça."
   },
   {
    "debut": 1097.25,
    "fin": 1099.89,
    "texte": "D'ailleurs, je devrais faire quelque chose de plus simple,"
   },
   {
    "debut": 1099.89,
    "fin": 1102.55,
    "texte": "parce que je sens que ça ne va pas être évident à calculer."
   },
   {
    "debut": 1103.37,
    "fin": 1107.48,
    "texte": "Je devrais mettre plutôt une case durée d'usinage réelle,"
   },
   {
    "debut": 1107.48,
    "fin": 1112.15,
    "texte": "durée d'usinage estimée, et ça m'effet directement le facteur de chronométrage."
   },
   {
    "debut": 1112.69,
    "fin": 1114.63,
    "texte": "C'est ce que je vais faire, ça, c'est une bonne idée, ça, tiens."
   },
   {
    "debut": 1118.14,
    "fin": 1118.42,
    "texte": "Voilà."
   },
   {
    "debut": 1119.59,
    "fin": 1122.07,
    "texte": "Bon, eh bien, maintenant, je vais essayer de passer à l'atelier"
   },
   {
    "debut": 1122.07,
    "fin": 1123.11,
    "texte": "et de faire la pièce."
   },
   {
    "debut": 1123.68,
    "fin": 1127.03,
    "texte": "Comme ça, il y aura une petite démo aussi sur du bois."
   },
   {
    "debut": 1129.89,
    "fin": 1130.19,
    "texte": "Voilà."
   },
   {
    "debut": 1132.77,
    "fin": 1135.2,
    "texte": "Merci à tous et à la prochaine vidéo."
   }
  ],
